{
  "name": "@sikorsky/site",
  "version": "0.5.4",
  "description": "A reusable Astro theme package with components, styles, and other features",
  "author": "Paul Sikorsky <p@sikorsky.design> & Andrei Tarasov <contact@andreitarasov.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreitarasov-dev/sikorsky-site.git"
  },
  "homepage": "https://github.com/andreitarasov-dev/sikorsky-site.git",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./styles": "./src/styles/global.css",
    "./fonts": "./src/fonts/Inter/inter.css",
    "./utils/*": "./src/utils/*",
    "./lib/*": "./src/lib/*",
    "./virtual": "./src/virtual.d.ts",
    "./src/virtual": "./src/virtual.d.ts"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "astro",
    "theme",
    "components"
  ],
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "astro": "^4.16.1",
    "firebase": "^11.0.1",
    "typescript": "^5.4.5",
    "@playwright/test": "1.62.1",
    "@astrojs/check": "^0.7.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev:sites": "node scripts/dev-sites.mjs",
    "check:consumers": "node scripts/check-consumers.mjs",
    "test:fixture": "playwright test",
    "upgrade:sites": "node scripts/upgrade-sites.mjs"
  }
}
